{
  "family": "nodejs-ecs-demo-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::491203818814:role/nodejs-ecs-demo-ecs-task-exec-role",
  "taskRoleArn": "arn:aws:iam::491203818814:role/nodejs-ecs-demo-ecs-task-exec-role",
  "containerDefinitions": [
    {
      "name": "nodejs-app",
      "image": "CONTAINER_IMAGE",
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/nodejs-ecs-demo-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        }
      ]
    }
  ]
}